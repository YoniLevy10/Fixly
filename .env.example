NEXT_PUBLIC_SUPABASE_URL=https://lfzxvmievofvdhxrwggo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# Production URL loaded inside the iOS/Android Capacitor shell
NEXT_PUBLIC_APP_URL=https://fixly.vercel.app

# Local device testing only: npm run cap:sync:dev (see docs/MOBILE_APP_STORE.md)
# CAPACITOR_SERVER_URL=http://192.168.1.42:3000

# Rich mock data (58 pros, 120+ requests) — ON by default; set false for real Supabase only
NEXT_PUBLIC_FF_DEMO_DATA=true
# NEXT_PUBLIC_FF_DEMO_DATA=false

# Feature flags (default on unless noted)
# NEXT_PUBLIC_FF_MONETIZATION=true
# NEXT_PUBLIC_FF_GOOGLE_OAUTH=true
# NEXT_PUBLIC_FF_ANALYTICS=true

# Google OAuth — enable in Supabase Dashboard → Auth → Google
# Redirect URL in Google Console = Supabase callback URL

# Stripe (see docs/MONETIZATION.md)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# SUPABASE_SERVICE_ROLE_KEY=...  # webhooks / admin jobs only

# Monitoring (optional — production)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=          # CI upload source maps (optional)
# SENTRY_ORG=                 # optional, for source maps
# SENTRY_PROJECT=fixly

# Rate limiting — Upstash Redis (recommended for Vercel production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
