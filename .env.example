# =============================================================================
# Fixly — Environment Variables (example)
# Copy to `.env.local` for local development. Never commit real secrets.
# Production: set these in Vercel → Project → Settings → Environment Variables
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App URL (OAuth redirects, Stripe return URLs, Capacitor) -----------------
NEXT_PUBLIC_APP_URL=https://fixly.vercel.app

# Local device testing only: npm run cap:sync:dev (see docs/MOBILE_APP_STORE.md)
# CAPACITOR_SERVER_URL=http://192.168.1.42:3000

# --- Demo / feature flags ----------------------------------------------------
# Demo data — OFF in production (default false). ON in development if unset.
NEXT_PUBLIC_FF_DEMO_DATA=false

# Explicit feature flags (defaults noted; unset often means "on" unless documented)
# NEXT_PUBLIC_FF_QUICK_REQUEST=true
# NEXT_PUBLIC_FF_PRICE_ESTIMATE=true
# NEXT_PUBLIC_FF_REQUEST_DRAFTS=true
# NEXT_PUBLIC_FF_PULL_REFRESH=true
# NEXT_PUBLIC_FF_SHARE_REQUEST=true
# NEXT_PUBLIC_FF_PRO_TEMPLATES=true
# NEXT_PUBLIC_FF_SEASONAL=true
# NEXT_PUBLIC_FF_ANALYTICS=true
# NEXT_PUBLIC_FF_PUSH=true
# NEXT_PUBLIC_FF_MONETIZATION=true
# NEXT_PUBLIC_FF_GOOGLE_OAUTH=true
# NEXT_PUBLIC_FF_LIVE_TRACKING=true

# --- Admin -------------------------------------------------------------------
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=you@fixly.app,ops@fixly.app

# --- Google OAuth ------------------------------------------------------------
# Enable in Supabase Dashboard → Auth → Providers → Google
# Redirect URL in Google Console = Supabase callback URL

# --- Stripe (see docs/MONETIZATION.md) ---------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...

# --- Web Push (VAPID) --------------------------------------------------------
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@fixly.app

# --- Cron (Vercel Cron → /api/cron/*) ----------------------------------------
# CRON_SECRET=generate-a-long-random-string

# --- Bamakor / partner integration (see docs/BAMAKOR_INTEGRATION.md) ---------
# FIXLY_API_KEYS=key1,key2
# FIXLY_API_KEY=single-key-alternative
# BAMAKOR_WEBHOOK_SECRET=shared-hmac-secret-for-outbound-callbacks
# FIXLY_WEBHOOK_DRY_RUN=1
# FIXLY_JOBS_STORE=memory

# --- Rate limiting — Upstash Redis (recommended on Vercel) -------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring (Sentry) -----------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=fixly

# --- Google Maps (optional — live map / geocoding) ---------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
