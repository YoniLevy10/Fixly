# =============================================================================
# Fixly Environment Variables Configuration
# Copy this file to .env.local or .env for local development
# Never commit real secrets.
# =============================================================================

# === SUPABASE (Required) ===
# URL of your Supabase project (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anonymous API key for client-side queries (Required)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard
# Service role key with admin access for server-side actions, webhooks, and partner API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === APP URL (Required for production) ===
# Public marketing / SEO base URL (OAuth redirects, payment callbacks, PWA, sitemap)
NEXT_PUBLIC_APP_URL=https://fixly.tech
# Optional: public product UI URL (usually the Vercel *.vercel.app alias)
# NEXT_PUBLIC_PRODUCT_URL=https://fixly-xxx.vercel.app
# Optional: hostname-only override treated as product host (no scheme)
# NEXT_PUBLIC_PRODUCT_HOST=fixly-xxx.vercel.app

# === GOOGLE SEARCH CONSOLE ===
# HTML tag verification token from Search Console (content= value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === TRANZILA — Israeli Payment Gateway (Required for monetization) ===
# Get these from my.tranzila.com → Settings → API Settings
# Supports: credit cards, Bit, Apple Pay, Google Pay, installments, recurring billing
TRANZILA_TERMINAL=
TRANZILA_API_APP_KEY=
TRANZILA_API_SECRET_KEY=
# Shared secret for /api/tranzila/webhook (Bearer, x-tranzila-secret, or ?secret=)
# Recommended: append ?secret=YOUR_SECRET to the notification URL in Tranzila portal
TRANZILA_WEBHOOK_SECRET=
# Set webhook URL in my.tranzila.com → My Billing → Transaction Notification Endpoint
# Webhook URL: https://yourdomain.com/api/tranzila/webhook?secret=YOUR_SECRET

# Optional legacy Stripe Customer Portal (manage/cancel) — not required for Tranzila checkout
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === ANALYTICS (Required before paid ads) ===
# GA4 Measurement ID (G-XXXXXXXX). Enable NEXT_PUBLIC_FF_ANALYTICS=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel ID — Events Manager → Data sources → Pixel
# Required for Meta Ads optimization (CompleteRegistration on waitlist signup)
NEXT_PUBLIC_META_PIXEL_ID=

# === PUSH NOTIFICATIONS (Free — generate keys locally) ===
# Generate VAPID keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fixly.app

# === MAPS (Free — no API key needed) ===
# Maps use OpenStreetMap/Leaflet. No Google Maps API key required.

# === RATE LIMITING (Optional — free tier available) ===
# Without Upstash Redis, rate limiting uses in-memory (resets on serverless cold starts)
# Free tier: 10K requests/day — https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === SENTRY (Optional — free tier: 5K errors/month) ===
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=fixly

# === FEATURE FLAGS ===
# Demo is ON by default (pre-funding). Legacy NEXT_PUBLIC_FF_DEMO_DATA is ignored.
# Kill demo after investment / real Supabase ops:
# NEXT_PUBLIC_FF_DEMO_KILL=true
NEXT_PUBLIC_FF_DEMO_DATA=true
NEXT_PUBLIC_FF_MONETIZATION=true
NEXT_PUBLIC_FF_GOOGLE_OAUTH=true
NEXT_PUBLIC_FF_ANALYTICS=true
NEXT_PUBLIC_FF_PUSH=true
NEXT_PUBLIC_FF_LIVE_TRACKING=true
NEXT_PUBLIC_FF_QUICK_REQUEST=true
NEXT_PUBLIC_FF_PRICE_ESTIMATE=true
NEXT_PUBLIC_FF_REQUEST_DRAFTS=true
NEXT_PUBLIC_FF_PULL_REFRESH=true
NEXT_PUBLIC_FF_SHARE_REQUEST=true
NEXT_PUBLIC_FF_PRO_TEMPLATES=true
NEXT_PUBLIC_FF_SEASONAL=true
# Pre-launch waitlist on fixly.tech only when demo is killed (see DEMO_MODE.md)
NEXT_PUBLIC_FF_PRELAUNCH=true

# === ADMIN & CRON JOBS ===
ADMIN_EMAILS=you@fixly.app,ops@fixly.app
CRON_SECRET=generate-a-long-random-string

# === BAMAKOR INTEGRATION (Optional) ===
BAMAKOR_API_KEY=
BAMAKOR_API_URL=
FIXLY_API_KEYS=key1,key2
FIXLY_API_KEY=single-key-alternative
BAMAKOR_WEBHOOK_SECRET=shared-hmac-secret-for-outbound-callbacks
FIXLY_WEBHOOK_DRY_RUN=0
FIXLY_JOBS_STORE=

# === MOBILE DEVELOPMENT (Optional) ===
# CAPACITOR_SERVER_URL=http://192.168.1.42:3000
