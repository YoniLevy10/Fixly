{
  "name": "fixly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:copy": "npx cap copy",
    "cap:ios": "npx cap open ios",
    "cap:sync:dev": "cross-env CAPACITOR_SERVER_URL=http://localhost:3000 npx cap sync ios",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "mobile:check": "node scripts/mobile-check.mjs",
    "mobile:sync-version": "node scripts/sync-ios-version.mjs",
    "mobile:prepare": "npm run mobile:sync-version && npm run icons:generate && npm run mobile:check && npm run cap:sync:ios",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "smoke:phase1": "FIXLY_JOBS_STORE=memory FIXLY_WEBHOOK_DRY_RUN=1 node --import tsx scripts/smoke-phase1.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.57.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
